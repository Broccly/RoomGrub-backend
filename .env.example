DB_NAME=roomgrub
DB_HOST=localhost
DB_PORT=5436
DB_USER=roomgrub_user
DB_PASSWORD=roomgrub_password
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

ENV=dev
JWT_SECRET=your-long-random-secret-key-min-32-chars
# Access token lifetime (minutes) and how long a device can stay idle before it is signed out (days)
JWT_ACCESS_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=90

# Google OAuth Client ID (used to verify the `aud` claim of Google id_tokens)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Upstash Redis (rediss:// TCP endpoint, password embedded in the URL)
REDIS_URL=rediss://default:your-password@your-instance.upstash.io:6379
CACHE_TTL_SECONDS=604800

# Local Docker Postgres used only by the pytest suite (see docker-compose.yml)
TEST_DB_NAME=roomgrub_test
TEST_DB_HOST=localhost
TEST_DB_PORT=55432
TEST_DB_USER=roomgrub_test
TEST_DB_PASSWORD=roomgrub_test
TEST_DB_POOL_SIZE=5
TEST_DB_MAX_OVERFLOW=5

# Firebase Admin service-account JSON on one line (optional; push is disabled if unset)
FIREBASE_CREDENTIALS_JSON=
